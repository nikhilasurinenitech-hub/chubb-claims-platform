{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ClaimChanged v1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "eventId": {
      "type": "string",
      "format": "uuid"
    },
    "schemaVersion": {
      "const": 1
    },
    "claimId": {
      "type": "string",
      "format": "uuid"
    },
    "version": {
      "type": "integer",
      "minimum": 0
    },
    "reference": {
      "type": "string"
    },
    "status": {
      "enum": [
        "SUBMITTED",
        "UNDER_REVIEW",
        "AWAITING_INFORMATION",
        "APPROVED",
        "SETTLED",
        "REJECTED"
      ]
    },
    "market": {
      "type": "string"
    },
    "currency": {
      "type": "string",
      "pattern": "^[A-Z]{3}$"
    },
    "reserveAmount": {
      "type": "number",
      "minimum": 0
    },
    "settlementAmount": {
      "type": "number",
      "minimum": 0
    },
    "assignee": {
      "type": [
        "string",
        "null"
      ]
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    },
    "updatedAt": {
      "type": "string",
      "format": "date-time"
    },
    "closedAt": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    }
  },
  "required": [
    "eventId",
    "schemaVersion",
    "claimId",
    "version",
    "reference",
    "status",
    "market",
    "currency",
    "reserveAmount",
    "settlementAmount",
    "assignee",
    "createdAt",
    "updatedAt",
    "closedAt"
  ]
}
