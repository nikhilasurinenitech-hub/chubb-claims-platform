{
  "info": {
    "name": "Claimspace Complete Workflow",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Run in order. Demo-only identities; no real payments. Reporting is asynchronous."
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080"
    },
    {
      "key": "password",
      "value": "ClaimsDemo!2026"
    },
    {
      "key": "claimId",
      "value": ""
    },
    {
      "key": "requestId",
      "value": ""
    },
    {
      "key": "version",
      "value": "0"
    }
  ],
  "item": [
    {
      "name": "01 Read claimant identity",
      "request": {
        "method": "GET",
        "header": [],
        "auth": {
          "type": "basic",
          "basic": [
            {
              "key": "username",
              "value": "maya",
              "type": "string"
            },
            {
              "key": "password",
              "value": "{{password}}",
              "type": "string"
            }
          ]
        },
        "url": "{{baseUrl}}/api/session"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Expected response\", function () { pm.response.to.have.status(200); });",
              "const data=pm.response.json();",
              "if(data.claim){pm.collectionVariables.set(\"claimId\",data.claim.id);pm.collectionVariables.set(\"version\",data.claim.version);}",
              "if(data.informationRequests){const pending=data.informationRequests.find(r=>!r.answeredAt);if(pending)pm.collectionVariables.set(\"requestId\",pending.id);}"
            ]
          }
        }
      ]
    },
